    "def extract_patient_id(x):\n",
    "    # split into a list\n",
    "    a = x.split('_')\n",
    "    patient_id = a[0]\n",
    "    \n",
    "    return patient_id\n",
    "data['patient_id'] = data['image_name'].apply(extract_patient_id)\n",
    "data.head()"
   ]
