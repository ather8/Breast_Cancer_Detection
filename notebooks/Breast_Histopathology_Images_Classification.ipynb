   "source": [
    "### Filter out patients with few patches"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "7ecd4236",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original Patient Count: 279\n",
      "Removed 2 patients with < 100 patches.\n",
      "Remaining Patient Count: 277\n",
      "Remaining Total Patches: 277367\n"
     ]
    }
   ],
   "source": [
    "def filter_low_patch_patients(df, min_patches=100):\n",
    "    \"\"\"Removes patients with fewer than min_patches from the dataset.\"\"\"\n",
    "    # Count patches per patient\n",
    "    counts = df['patient_id'].value_counts()\n",
    "    \n",
    "    # Identify IDs that meet the threshold\n",
    "    keep_ids = counts[counts >= min_patches].index\n",
    "    \n",
    "    # Filter DataFrame\n",
    "    filtered_df = df[df['patient_id'].isin(keep_ids)].copy()\n",
    "    \n",
    "    # Print Summary\n",
    "    removed_count = len(counts) - len(keep_ids)\n",
    "    print(f\"Original Patient Count: {len(counts)}\")\n",
    "    print(f\"Removed {removed_count} patients with < {min_patches} patches.\")\n",
    "    print(f\"Remaining Patient Count: {len(keep_ids)}\")\n",
    "    print(f\"Remaining Total Patches: {len(filtered_df)}\")\n",
    "    \n",
    "    return filtered_df\n",
    "\n",
    "# Apply the filter\n",
    "data = filter_low_patch_patients(data, min_patches=100)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c809a439",
   "metadata": {},
   "source": [
    "## Split Data Into Train and Test"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d7a21ebd",
   "metadata": {},
   "source": [
    "To prevent Data Leakage, we must split the data by patient_id. If we simply use a random split, patches from the same patient (sharing the same tissue texture and lighting) would appear in both sets, causing the model to \"memorize\" patients rather than learning \"cancer features.\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "b50d485c",
   "metadata": {},
   "outputs": [],
   "source": [
    "def split_data_by_patient(df, test_size=0.2):\n",
    "    \"\"\"Splits the dataframe into train and test sets based on Patient ID.\"\"\"\n",
    "    gss = GroupShuffleSplit(n_splits=1, test_size=test_size, random_state=42)\n",
    "    \n",
    "    # Extract indices for the split\n",
    "    train_idx, test_idx = next(gss.split(df, groups=df['patient_id']))\n",
    "    \n",
    "    train_df = df.iloc[train_idx].copy()\n",
    "    test_df = df.iloc[test_idx].copy()\n",
    "    \n",
    "    # Verification\n",
    "    print(f\"Total Patients: {df['patient_id'].nunique()}\")\n",
    "    print(f\"Train Patients: {train_df['patient_id'].nunique()} | Patches: {len(train_df)}\")\n",
    "    print(f\"Test Patients: {test_df['patient_id'].nunique()} | Patches: {len(test_df)}\")\n",
    "    \n",
    "    # Check for leakage (should be empty set)\n",
    "    overlap = set(train_df['patient_id']) & set(test_df['patient_id'])\n",
    "    print(f\"Patient overlap check: {overlap}\")\n",
    "    \n",
    "    return train_df, test_df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "b7a0fc1d",
   "metadata": {},
   "outputs": [
